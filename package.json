{
  "name": "colgar-foundation-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node scripts/init-mongodb.mjs",
    "seed:content": "node --experimental-strip-types scripts/seed-content.mjs",
    "staff:provision": "node scripts/provision-staff.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:public": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:admin": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env admin",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
