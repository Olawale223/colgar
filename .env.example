# Local development only. Production role is configured in wrangler.jsonc.
APP_ROLE=combined

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=colgar
RATE_LIMIT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=YOUR_ADMIN_APPLICATION_AUD_TAG

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets; never expose these in client code.
RESEND_API_KEY=
NEWSLETTER_FROM="Colgar Foundation <updates@YOUR_VERIFIED_DOMAIN>"
PAYSTACK_SECRET_KEY=
